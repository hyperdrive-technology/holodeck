{
  "name": "@holodeck/provider-aws",
  "version": "0.1.0",
  "description": "aws.cloudwatch: live CloudWatch metrics, alarm states, metric/alarm history and resource discovery for Holodeck documents (AWS SDK v3 modular clients; browser and Node)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./holodeck-package": {
      "types": "./dist/holodeck-package.d.ts",
      "import": "./dist/holodeck-package.js"
    },
    "./holodeck.package.json": "./holodeck.package.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "!src/**/*.test.ts",
    "!src/test-support/**",
    "holodeck.package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "npm run build",
    "smoke": "node ../../scripts/smoke-dist.mjs . && node --no-deprecation scripts/smoke-holodeck-package.mjs && node scripts/browser-bundle-check.mjs"
  },
  "keywords": [
    "holodeck",
    "provider",
    "aws",
    "cloudwatch",
    "metrics",
    "alarms",
    "monitoring"
  ],
  "author": "Hyperdrive Technology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperdrive-technology/holodeck.git",
    "directory": "packages/provider-aws"
  },
  "homepage": "https://github.com/hyperdrive-technology/holodeck/tree/main/packages/provider-aws#readme",
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1152.0",
    "@aws-sdk/client-cognito-identity": "^3.1152.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1152.0",
    "@aws-sdk/client-sts": "^3.1152.0",
    "@holodeck/sdk": "file:../../../holodeck-sdk/ts",
    "@smithy/fetch-http-handler": "^5.8.0"
  },
  "devDependencies": {
    "@smithy/types": "^4.19.0",
    "@types/node": "^26.6.5",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  }
}
