{
  "name": "@holodeck/editor-2.5d-react",
  "version": "0.1.0",
  "description": "2.5D React editor for orthographic process diagrams",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./holodeck-package": {
      "types": "./dist/holodeck-package.d.ts",
      "import": "./dist/holodeck-package.mjs",
      "require": "./dist/holodeck-package.js"
    },
    "./holodeck.package.json": "./holodeck.package.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "assets/**/*",
    "holodeck.package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "tuner": "vite src/iso --open /tank-tuner.html",
    "parts": "vite src/iso --open /parts.html",
    "parts:build": "node scripts/build-parts.mjs",
    "parts:watch": "node scripts/build-parts.mjs --watch",
    "prepublishOnly": "npm run build",
    "smoke": "node ../../scripts/smoke-dist.mjs . && node --no-deprecation scripts/smoke-holodeck-package.mjs",
    "check:vite-consumer": "node ../../scripts/vite-consumer-check.mjs .",
    "visual": "vitest run src/iso/scene-render.test.ts",
    "visual:record": "HOLODECK_VISUAL_RECORD=1 vitest run src/iso/scene-render.test.ts",
    "visual:reference": "node scripts/make-reference-canvas.mjs"
  },
  "keywords": [
    "holodeck",
    "process",
    "visualization",
    "2.5d",
    "react",
    "editor",
    "r3f"
  ],
  "author": "Hyperdrive Technology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperdrive-technology/holodeck.git",
    "directory": "packages/editor-2.5d-react"
  },
  "homepage": "https://github.com/hyperdrive-technology/holodeck/tree/main/packages/editor-2.5d-react#readme",
  "dependencies": {
    "@holodeck/sdk": "file:../../../holodeck-sdk/ts",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.186.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.59.1",
    "pngjs": "7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <19.4",
    "react-dom": ">=19.2.0 <19.4"
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  }
}
