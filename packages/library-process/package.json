{
  "name": "@holodeck/library-process",
  "version": "0.1.0",
  "description": "Industrial process parts (valves, rotating equipment, heat transfer, instruments, electrical) for holodeck.iso",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./holodeck-package": { "types": "./dist/holodeck-package.d.ts", "import": "./dist/holodeck-package.js" },
    "./holodeck.package.json": "./holodeck.package.json",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": ["dist/**/*", "assets/**/*", "holodeck.package.json", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "parts:build": "node scripts/build-parts.mjs",
    "parts:preview": "node scripts/build-parts.mjs --preview-dir /tmp/process-previews",
    "prepublishOnly": "npm run build",
    "smoke": "node ../../scripts/smoke-dist.mjs . && node --no-deprecation scripts/smoke-holodeck-package.mjs"
  },
  "keywords": ["holodeck", "process", "industrial", "isometric", "valves", "instruments"],
  "author": "Hyperdrive Technology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperdrive-technology/holodeck.git",
    "directory": "packages/library-process"
  },
  "dependencies": { "@holodeck/sdk": "file:../../../holodeck-sdk/ts" },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "three": "0.186.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": { "node": ">=26.13.0" },
  "packageManager": "pnpm@12.16.1",
  "publishConfig": { "access": "public" }
}
