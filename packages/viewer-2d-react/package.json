{
  "name": "@starfleet/viewer-2d-react",
  "version": "0.1.0",
  "description": "2D React viewer for Starfleet infrastructure diagrams",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "lint:fix": "eslint src/**/*.ts src/**/*.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "starfleet",
    "infrastructure",
    "visualization",
    "2d",
    "react",
    "viewer",
    "diagram"
  ],
  "author": "Hyperdrive Technology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperdrive-technology/starfleet.git",
    "directory": "packages/viewer-2d-react"
  },
  "bugs": {
    "url": "https://github.com/hyperdrive-technology/starfleet/issues"
  },
  "homepage": "https://github.com/hyperdrive-technology/starfleet/tree/main/packages/viewer-2d-react#readme",
  "dependencies": {
    "@starfleet/sdk": "workspace:*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "reactflow": "^11.0.0",
    "dagre": "^0.8.5",
    "clsx": "^2.0.0",
    "lucide-react": "^0.400.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/dagre": "^0.7.52",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@storybook/addon-essentials": "^7.0.0",
    "@storybook/addon-links": "^7.0.0",
    "@storybook/blocks": "^7.0.0",
    "@storybook/react": "^7.0.0",
    "@storybook/react-vite": "^7.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "storybook": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
