{
  "name": "@holodeck/assets-aws",
  "version": "0.1.0",
  "description": "Official AWS Architecture Icons on cloud archetypes: AWS services as data-only holodeck.iso parts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./holodeck-package": {
      "types": "./dist/holodeck-package.d.ts",
      "import": "./dist/holodeck-package.js"
    },
    "./holodeck.package.json": "./holodeck.package.json",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "assets/**/*",
    "holodeck.package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "npm run build",
    "smoke": "node ../../scripts/smoke-dist.mjs . && node --no-deprecation scripts/smoke-holodeck-package.mjs",
    "assets:sync": "node scripts/sync-assets.mjs"
  },
  "keywords": [
    "holodeck",
    "aws",
    "architecture",
    "isometric",
    "icons"
  ],
  "author": "Hyperdrive Technology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperdrive-technology/holodeck.git",
    "directory": "packages/assets-aws"
  },
  "dependencies": {
    "@holodeck/sdk": "file:../../../holodeck-sdk/ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "three": "0.186.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.33.2",
  "publishConfig": {
    "access": "public"
  }
}
