{
  "name": "@starfleet/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Starfleet infrastructure visualization",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "starfleet": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --clean --target node18",
    "dev": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --watch --target node18",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "starfleet",
    "cli",
    "infrastructure",
    "visualization",
    "3d",
    "importer"
  ],
  "author": "Hyperdrive Technology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperdrive-technology/starfleet.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/hyperdrive-technology/starfleet/issues"
  },
  "homepage": "https://github.com/hyperdrive-technology/starfleet/tree/main/packages/cli",
  "dependencies": {
    "@starfleet/sdk": "^0.1.0",
    "commander": "^12.0.0",
    "execa": "^8.0.0",
    "chokidar": "^3.5.0",
    "vite": "^5.0.0",
    "zod": "^3.22.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "inquirer": "^9.2.0",
    "fs-extra": "^11.2.0",
    "globby": "^14.0.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "peerDependencies": {
    "node": ">=18.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@8.0.0"
}
