{
  "name": "@starfleet/viewer-3d-react",
  "version": "0.1.0",
  "description": "3D React viewer for Starfleet infrastructure scenes (React Three Fiber, WebGPU-ready)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./webgpu": {
      "types": "./dist/webgpu.d.ts",
      "import": "./dist/webgpu.mjs",
      "require": "./dist/webgpu.js"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/webgpu.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/webgpu.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "lint:fix": "eslint src/**/*.ts src/**/*.tsx --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "starfleet",
    "infrastructure",
    "visualization",
    "3d",
    "react",
    "react-three-fiber",
    "three.js",
    "webgpu",
    "viewer"
  ],
  "author": "Hyperdrive Technology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperdrive-technology/starfleet.git",
    "directory": "packages/viewer-3d-react"
  },
  "bugs": {
    "url": "https://github.com/hyperdrive-technology/starfleet/issues"
  },
  "homepage": "https://github.com/hyperdrive-technology/starfleet/tree/main/packages/viewer-3d-react#readme",
  "dependencies": {
    "@react-three/drei": "11.0.0-alpha.5",
    "@react-three/fiber": "10.0.0-alpha.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <19.3",
    "react-dom": ">=19.0.0 <19.3",
    "three": ">=0.181.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
